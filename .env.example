# Variáveis de ambiente do Finanpy.
# Copie este arquivo para .env e ajuste os valores. O .env não vai para o
# repositório. Sem ele, valem os padrões de desenvolvimento definidos em
# core/settings.py.
#
# Uso local: exporte as variáveis no terminal antes do runserver
# (o Django não lê o .env sozinho).
# Uso com Docker: o docker compose lê o .env da raiz automaticamente.

# Chave secreta do Django. Obrigatório trocar fora do desenvolvimento.
# Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Se a chave tiver o caractere $, envolva o valor em aspas simples
# (o docker compose interpreta $ como variável).
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

# Modo de depuração: True/False (também aceita 1/0). Padrão: True.
# Use False fora do desenvolvimento.
DEBUG=True

# Hosts aceitos pela aplicação, separados por vírgula.
# Padrão: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Caminho do arquivo SQLite (opcional). Padrão: db.sqlite na raiz do projeto.
# No Docker é definido como /app/data/db.sqlite (pasta montada no volume).
# SQLITE_PATH=/app/data/db.sqlite

# ---------------------------------------------------------------------------
# Agente de IA financeiro (OpenAI + LangChain). Veja o README.
# ---------------------------------------------------------------------------

# Chave da API da OpenAI. Vazia (padrão) desabilita a geração de análises:
# o botão do dashboard some e o command encerra com erro. Nunca versione a
# chave real.
OPENAI_API_KEY=

# Modelo usado pelo agente. Padrão: gpt-5-mini
AI_MODEL_NAME=gpt-5-mini

# Timeout, em segundos, de cada chamada ao modelo. Padrão: 60
AI_REQUEST_TIMEOUT=60

# Limite de tokens de saída por chamada (inclui o raciocínio). Padrão: 4000
AI_MAX_COMPLETION_TOKENS=4000

# Mínimo de transações no período analisado para chamar a IA. Padrão: 5
AI_MIN_TRANSACTIONS=5

# Intervalo mínimo, em minutos, entre pedidos pelo botão do dashboard.
# Padrão: 60
AI_MANUAL_COOLDOWN_MINUTES=60
